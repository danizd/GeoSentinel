# Copia este archivo a .env y ajusta los valores.

# Backend de GeoSentinel (proxy de todas las fuentes, incluido CR360)
VITE_API_BASE_URL=http://localhost:8000

# Token de Mapbox (nunca hardcodeado en código)
VITE_MAPBOX_TOKEN=

# Polling de incidentes del dashboard principal (ms). Default: 30000
VITE_POLL_INCIDENTS_MS=30000

# --- Página /radar (CR360 - Conflict Radar 360) ---

# Países de interés (ISO-3 separados por coma). Se envían al proxy /v1/cr360/*.
VITE_CR360_COUNTRIES=ESP,RUS,UKR

# Título del enlace en el dashboard y de la página del radar.
VITE_RADAR_TITLE=Conflicto Ucrania - Rusia

# Intervalo de polling del radar (ms). Default: 3 horas.
VITE_POLL_CR360_MS=10800000
